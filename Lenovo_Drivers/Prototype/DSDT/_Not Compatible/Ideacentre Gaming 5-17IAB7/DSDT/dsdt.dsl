                    /* 0008 */  0x79, 0x00                                       // y.
                })
                Name (BUF2, Buffer (0x0A)
                {
                    /* 0000 */  0x47, 0x01, 0x00, 0x00, 0x00, 0x00, 0x01, 0xFF,  // G.......
                    /* 0008 */  0x79, 0x00                                       // y.
