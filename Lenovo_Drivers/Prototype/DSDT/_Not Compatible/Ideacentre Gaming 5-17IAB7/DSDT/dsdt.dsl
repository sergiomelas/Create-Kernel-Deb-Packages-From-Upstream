                    /* 0008 */  0x00, 0x00, 0x69, 0x00, 0x79, 0x00               // ..i.y.
                })
                CreateDWordField (SBR0, 0x04, BAS0)
                BAS0 = SBRG /* \SBRG */
                ConcatenateResTemplate (BUF0, SBR0, Local0)
                If (((PCHS == PCHH) || (PCHS == 0x04)))
                {
