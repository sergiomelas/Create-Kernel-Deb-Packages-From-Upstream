            }
            Else
            {
                Local0 = Zero
                If ((Arg1 & 0x00040000))
                {
                    OSU4 = One
                }
                Else
                {
                    OSU4 = Zero
                }

                If (((U4CM & 0x70) == Zero))
                {
                    If ((OSU4 == One))
                    {
