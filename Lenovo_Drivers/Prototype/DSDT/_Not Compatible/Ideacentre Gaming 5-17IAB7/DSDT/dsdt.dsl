                    /* 0050 */  0x79, 0x00                                       // y.
                })
                CreateWordField (BUF0, 0x4A, AMIN)
                CreateWordField (BUF0, 0x4C, AMAX)
                AMIN = PMBS /* \PMBS */
                AMAX = PMBS /* \PMBS */
                Name (SBR0, Buffer (0x0E)
