    Method (RWAK, 1, Serialized)
    {
        D8XH (One, 0xAB)
        Local0 = Zero
        Local0 = (Arg0 + 0xA0)
        D8XH (Zero, Local0)
        Name (RPWM, Zero)
        If ((DSTS == Zero))
