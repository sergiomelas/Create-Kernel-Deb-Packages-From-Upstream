                    /* 0008 */  0x00, 0x00, 0x6A, 0x00, 0x86, 0x09, 0x00, 0x01,  // ..j.....
                    /* 0010 */  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,  // ........
                    /* 0018 */  0x86, 0x09, 0x00, 0x01, 0x00, 0x00, 0x6F, 0xFD,  // ......o.
                    /* 0020 */  0x00, 0x00, 0x91, 0x00, 0x86, 0x09, 0x00, 0x01,  // ........
                    /* 0028 */  0x00, 0x00, 0x00, 0xFE, 0x00, 0x00, 0x02, 0x00,  // ........
                    /* 0030 */  0x86, 0x09, 0x00, 0x01, 0x00, 0x00, 0x20, 0xFE,  // ...... .
                    /* 0038 */  0x00, 0x00, 0x60, 0x00, 0x86, 0x09, 0x00, 0x00,  // ..`.....
                    /* 0040 */  0x00, 0x00, 0x00, 0xFF, 0x00, 0x00, 0x00, 0x01,  // ........
                    /* 0048 */  0x47, 0x01, 0x00, 0x00, 0x00, 0x00, 0x01, 0xFF,  // G.......
                    /* 0050 */  0x79, 0x00                                       // y.
                })
                CreateWordField (BUF0, 0x4A, AMIN)
                CreateWordField (BUF0, 0x4C, AMAX)
                AMIN = PMBS /* \PMBS */
                AMAX = PMBS /* \PMBS */
                CreateDWordField (BUF0, 0x10, GBAS)
                CreateDWordField (BUF0, 0x14, GLEN)
                If ((PCHS == PCHH))
