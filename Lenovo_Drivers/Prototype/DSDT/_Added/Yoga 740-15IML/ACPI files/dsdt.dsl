                        /* 0008 */  0x00, 0x01, 0x06, 0x00, 0x80, 0x1A, 0x06, 0x00,  // ........
                        /* 0010 */  0x00, 0x00, 0x5C, 0x5F, 0x53, 0x42, 0x2E, 0x50,  // ..\_SB.P
                        /* 0018 */  0x43, 0x49, 0x30, 0x2E, 0x49, 0x32, 0x43, 0x33,  // CI0.I2C3
                        /* 0020 */  0x00, 0x79, 0x00                                 // .y.
                    })
                    CreateWordField (IIC3, 0x10, DAD3)
