                        /* 0010 */  0x00, 0x19, 0x00, 0x28, 0x00, 0x00, 0x00, 0x08,  // ...(....
                        /* 0018 */  0x00, 0x5C, 0x5F, 0x53, 0x42, 0x2E, 0x50, 0x43,  // .\_SB.PC
                        /* 0020 */  0x49, 0x30, 0x2E, 0x47, 0x50, 0x49, 0x30, 0x00,  // I0.GPI0.
