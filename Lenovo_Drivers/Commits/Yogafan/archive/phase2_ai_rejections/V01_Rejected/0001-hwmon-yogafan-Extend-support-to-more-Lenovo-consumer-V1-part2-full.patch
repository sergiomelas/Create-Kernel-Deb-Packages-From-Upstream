+	.tau_ms = 1000, .slew_time_s = 4, .stop_threshold = 50,
+	.paths = { "\\_SB.PCI0.LPC0.EC0.FAN0", NULL }
+};
+
+static struct yogafan_config yoga_510_discrete_cfg = {
