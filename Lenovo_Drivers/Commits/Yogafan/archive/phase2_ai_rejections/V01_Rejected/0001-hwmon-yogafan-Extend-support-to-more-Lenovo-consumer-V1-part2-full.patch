+static struct yogafan_config yoga_aura_cfg = {
+	.multiplier = 100, .fan_count = 2, .n_max = 0,
+	.r_max = 6000, .tau_ms = 1100, .slew_time_s = 4, .stop_threshold = 50,
+	.paths = { "\\_SB.PC00.LPCB.EC0.FA1S", "\\_SB.PC00.LPCB.EC0.FA2S" }
+};
