+	.r_max = 6500, .tau_ms = 1200, .slew_time_s = 5, .stop_threshold = 50,
+	.paths = { "\\_SB.PCI0.LPC0.EC0.FANS", "\\_SB.PCI0.LPC0.EC0.FA2S" }
+};
+
