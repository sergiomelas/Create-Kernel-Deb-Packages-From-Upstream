+static struct yogafan_config yoga_slim_cfg = {
+	.multiplier = 100, .fan_count = 1, .n_max = 0,
+	.r_max = 5500, .tau_ms = 900, .slew_time_s = 3, .stop_threshold = 50,
+	.paths = { "\\_SB.PCI0.LPC0.EC0.FANS", NULL }
+};
+
