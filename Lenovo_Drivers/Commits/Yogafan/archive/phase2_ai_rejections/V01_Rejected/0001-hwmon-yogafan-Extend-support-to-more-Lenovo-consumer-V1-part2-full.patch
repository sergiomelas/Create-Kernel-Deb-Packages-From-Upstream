+	.multiplier = 0, .fan_count = 1, .n_max = 35, .r_max = 4800,
+	.tau_ms = 1100, .slew_time_s = 4, .stop_threshold = 50,
+	.paths = { "\\_SB.PCI0.LPC0.EC0.FAN0", "\\_SB.PCI0.LPC0.EC0.FANS" }
+};
+
